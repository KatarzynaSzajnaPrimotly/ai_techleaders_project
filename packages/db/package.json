{
  "name": "@devmentor/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migration:create": "tsx src/scripts/migrate.ts create",
    "migration:up": "tsx src/scripts/migrate.ts up",
    "migration:down": "tsx src/scripts/migrate.ts down",
    "setup": "tsx src/scripts/setup.ts"
  },
  "dependencies": {
    "@devmentor/core": "*",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
