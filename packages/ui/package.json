{
  "name": "@devmentor/ui",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:storybook": "tsc --noEmit --project .storybook/tsconfig.json",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --ci",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --config ./vitest.storybook.config.ts",
    "test-storybook:themes": "node ./scripts/test-storybook-themes.mjs",
    "check-design-tokens": "node ./scripts/check-design-tokens.mjs"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
