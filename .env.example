# Variable reference for packages/db. Export these in your shell (migration scripts read the process
# environment only) or put them in packages/app/.env.local (Next.js app only). Not loaded automatically from here.
DEVMENTOR_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/devmentor
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Optional app configuration. JWT_SECRET must contain at least 32 characters.
# ALLOW_INSECURE_HTTP is test-only; never enable it with an HTTPS APP_URL.
JWT_SECRET=
ALLOW_INSECURE_HTTP=false
