# Variable reference for packages/db. Export these in your shell (migration scripts read the process
# environment only) or put them in packages/app/.env.local (Next.js app only). Not loaded automatically from here.
DEVMENTOR_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/devmentor
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Optional app configuration. JWT_SECRET must contain at least 32 characters.
# ALLOW_INSECURE_HTTP is test-only; never enable it with an HTTPS APP_URL.
APP_URL=
JWT_SECRET=
ALLOW_INSECURE_HTTP=false

# GitHub OAuth is optional until the auth routes are enabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Defaults: https://github.com and https://api.github.com.
GITHUB_OAUTH_BASE_URL=
GITHUB_API_BASE_URL=

# Auth S02: unset means no trusted client IP (only per e-mail rate limits apply).
# Set this to the number of proxies that append trusted addresses to X-Forwarded-For (0 disables IP limits).
# TRUST_PROXY_HOPS=1
# E-mail delivery is disabled unless an explicit transport is selected. `log` is for local/test use; link tokens are redacted.
MAILER_TRANSPORT=
# Comma-separated founder e-mail allowlist; listed non-mentors sign in as operators.
OPERATOR_EMAILS=

# Invitation and mentor onboarding windows (defaults are 14 days each).
INVITATION_TTL_DAYS=14
MENTOR_PUBLISH_WINDOW_DAYS=14
